{
  "expo": {
    "name": "Neo",
    "slug": "neo-cloud-agent",
    "scheme": "neo",
    "version": "0.1.4",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/linabell-face.png",
    "ios": {
      "bundleIdentifier": "agent.neo.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSMicrophoneUsageDescription": "Neo 用麦克风把你说的话写进发送框。"
      }
    },
    "android": {
      "package": "agent.neo.mobile",
      "usesCleartextTraffic": true,
      "versionCode": 5,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/linabell-face.png",
        "backgroundColor": "#f7f3df"
      }
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#f7f3df",
      "translucent": true
    },
    "plugins": [
      "./plugins/with-cleartext.cjs",
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "apiUrl": "http://62.234.211.200",
      "eas": {
        "projectId": "904b90b0-8796-4c87-80b5-2eb1d7b4f024"
      }
    },
    "owner": "kaibairen"
  }
}
