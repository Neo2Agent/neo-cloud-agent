{
  "name": "@neo-cloud-agent/desk",
  "version": "0.1.0",
  "private": true,
  "description": "Neo Desk desktop client",
  "author": "Neo",
  "type": "module",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron app/main.cjs",
    "dev": "tsx scripts/dev.ts",
    "build": "vite build --config ui/vite.config.ts",
    "pack": "tsx scripts/pack.ts",
    "compile": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@neo-cloud-agent/contracts": "workspace:*",
    "@neo-cloud-agent/ui": "workspace:*",
    "animal-island-ui": "^1.7.0",
    "classnames": "^2.5.1",
    "lucide-react": "^1.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "vite": "^6.4.3"
  }
}
