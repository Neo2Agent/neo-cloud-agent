{
  "name": "@neo-cloud-agent/desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron app/main.cjs",
    "dev": "tsx scripts/dev.ts",
    "build": "vite build --config ui/vite.config.ts",
