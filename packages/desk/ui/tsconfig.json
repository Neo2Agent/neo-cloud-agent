{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client"]
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../src/composer-size.ts", "../src/format.ts", "../src/ports.ts", "../src/rail.ts", "../src/stream.ts", "../src/term-keys.ts", "../src/file-kind.ts", "../src/skill-list.ts"],
  "exclude": ["./**/*.test.ts"]
}
