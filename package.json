{
  "name": "neo-cloud-agent",
  "private": true,
  "description": "Cloud agent control plane and VM worker, with pi-agent as the in-VM kernel.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @neo-cloud-agent/control-plane --filter @neo-cloud-agent/llm-gateway dev",
    "dev:control-plane": "pnpm --filter @neo-cloud-agent/control-plane dev",
    "dev:gateway": "pnpm --filter @neo-cloud-agent/llm-gateway dev",
    "dev:worker": "pnpm --filter @neo-cloud-agent/worker dev",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
