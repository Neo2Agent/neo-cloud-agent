{
  "name": "neo-cloud-agent",
  "private": true,
  "description": "Cloud agent control plane and VM worker, with pi-agent as the in-VM kernel.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @neo-cloud-agent/control-plane --filter @neo-cloud-agent/llm-gateway dev",
    "dev:control-plane": "pnpm --filter @neo-cloud-agent/control-plane dev",
    "dev:gateway": "pnpm --filter @neo-cloud-agent/llm-gateway dev",
    "dev:worker": "pnpm --filter @neo-cloud-agent/worker dev",
    "neo": "tsx packages/cli/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @neo-cloud-agent/web --config.engine-strict=false typecheck",
    "test": "pnpm --filter @neo-cloud-agent/web --config.engine-strict=false build && tsx --test packages/**/*.test.ts",
    "build:web": "pnpm --filter @neo-cloud-agent/web --config.engine-strict=false build",
    "test:e2e": "tsx scripts/e2e-http.ts",
    "test:e2e:live": "E2E_EXPECT_README=1 tsx scripts/e2e-http.ts",
    "test:docker": "tsx --test packages/control-plane/src/e2e/docker-turn.test.ts",
    "test:firecracker": "FIRECRACKER_E2E=1 tsx --test packages/control-plane/src/e2e/firecracker-turn.test.ts",
    "fc:assets": "bash infra/firecracker/fetch-assets.sh",
    "fc:rootfs": "bash infra/firecracker/build-rootfs.sh",
    "build:worker-image": "docker build -f infra/Dockerfile.worker -t neo-cloud-agent-worker:dev ."
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
