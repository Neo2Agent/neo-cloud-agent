FROM node:22-bookworm-slim
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/control-plane/package.json packages/control-plane/
COPY packages/extensions/package.json packages/extensions/
COPY packages/llm-gateway/package.json packages/llm-gateway/
COPY packages/worker/package.json packages/worker/
RUN pnpm install --frozen-lockfile --filter @neo-cloud-agent/control-plane...
COPY tsconfig.base.json tsconfig.json ./
COPY packages/contracts packages/contracts
COPY packages/control-plane packages/control-plane
ENV CONTROL_PLANE_PORT=8080
EXPOSE 8080
CMD ["pnpm", "--filter", "@neo-cloud-agent/control-plane", "start"]
