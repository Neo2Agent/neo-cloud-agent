[Unit]
Description=neo-loop (AgentScope Java turn engine)
After=network.target
# Generic template. Lighthouse production copy is
# .cursor/skills/tencent-lighthouse-deploy/units/neo-loop.service
# (WorkingDirectory=/home/ubuntu/neo-cloud-agent). Production enables this unit.

[Service]
Type=simple
WorkingDirectory=/opt/neo
EnvironmentFile=-/opt/neo/.env
# Loop must never see provider keys even if they sit in the shared env file.
UnsetEnvironment=DEEPSEEK_API_KEY OPENAI_API_KEY ANTHROPIC_API_KEY LLM_API_KEY LLM_UPSTREAM_API_KEY
Environment=NEO_LOOP_PORT=8082
Environment=NEO_LOOP_BIND=127.0.0.1
Environment=NEO_LOOP_JAVA_XMX=512m
ExecStart=/bin/bash -c 'exec /usr/bin/java -Xmx"${NEO_LOOP_JAVA_XMX:-512m}" -jar /opt/neo/services/neo-loop/target/neo-loop-0.1.0.jar'
Restart=on-failure
RestartSec=3
MemoryMax=768M
# Bind loop to localhost only; Caddy must not reverse-proxy :8082.

[Install]
WantedBy=multi-user.target
