[Unit]
Description=neo-loop (TypeScript cloud loop for Remote Control)
After=network.target
# Generic template. Lighthouse production copy is
# .cursor/skills/tencent-lighthouse-deploy/units/neo-loop.service
# Cloud stays on pi. This process is the Remote Control loop.
# Bind to localhost only. Do not reverse-proxy :8082.

[Service]
Type=simple
WorkingDirectory=/opt/neo
EnvironmentFile=-/opt/neo/.env
UnsetEnvironment=DEEPSEEK_API_KEY OPENAI_API_KEY ANTHROPIC_API_KEY LLM_API_KEY LLM_UPSTREAM_API_KEY
Environment=NEO_LOOP_PORT=8082
Environment=NEO_LOOP_BIND=127.0.0.1
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecStart=/usr/bin/node --import tsx packages/loop/src/index.ts
Restart=on-failure
RestartSec=3
MemoryMax=384M

[Install]
WantedBy=multi-user.target
