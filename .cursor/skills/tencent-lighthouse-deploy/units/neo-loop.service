[Unit]
Description=neo-loop (TypeScript cloud loop for Remote Control)
After=network.target
# Listens on 127.0.0.1:8082 only. Caddy and the Lighthouse firewall must not expose it.
# Cloud runs stay on pi. Remote Control uses this process when /health is ok.

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/neo-cloud-agent
EnvironmentFile=-/home/ubuntu/neo-cloud-agent/.env
# The loop must never see provider keys even if they sit in the shared env file.
UnsetEnvironment=DEEPSEEK_API_KEY OPENAI_API_KEY ANTHROPIC_API_KEY LLM_API_KEY LLM_UPSTREAM_API_KEY
Environment=NEO_LOOP_PORT=8082
Environment=NEO_LOOP_BIND=127.0.0.1
Environment=NODE_OPTIONS=--max-old-space-size=256
Environment=PATH=/usr/bin:/usr/local/bin
ExecStart=/usr/local/bin/node --import tsx packages/loop/src/index.ts
Restart=on-failure
RestartSec=3
MemoryMax=384M
KillMode=process

[Install]
WantedBy=multi-user.target
