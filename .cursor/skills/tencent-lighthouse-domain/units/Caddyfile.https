# 现网 HTTPS：Caddy 向 Let's Encrypt 自动申请并续期（0 元）。
# 覆盖到 /etc/caddy/Caddyfile 后 `sudo caddy validate` 再 `sudo systemctl reload caddy`。
# 不要用轻量控制台一键 HTTPS（会按应用镜像改 Nginx）。
# 域名走 443；IP http://62.234.211.200 仍听 :80，避免旧书签断掉。
#
# 同一域名两条路径，不要 /a /b，也不要再买子域：
#   /        → 对话页  127.0.0.1:8080
#   /admin/  → 管理台  127.0.0.1:8090（strip /admin 后 admin-api 仍听 /）
# 8090 不要开公网防火墙。

neorun.cloud, www.neorun.cloud {
	encode gzip zstd {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}
	redir /admin /admin/ 308
	handle_path /admin/* {
		reverse_proxy 127.0.0.1:8090 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}
}

http://62.234.211.200 {
	encode gzip zstd {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}
	redir /admin /admin/ 308
	handle_path /admin/* {
		reverse_proxy 127.0.0.1:8090 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}
}
