# 只写在库机 /home/ubuntu/mem0/.env（chmod 600）。不要提交、不要打印。
POSTGRES_USER=mem0
POSTGRES_PASSWORD=
POSTGRES_DB=mem0
POSTGRES_COLLECTION_NAME=memories

MEM0_API_KEY=
MEM0_TELEMETRY=false

# New API（同机 dbnet 主机名 new-api）。值从 /home/ubuntu/db/.new-api-token 拷，不要复用到 git。
OPENAI_API_KEY=
OPENAI_BASE_URL=http://new-api:3000/v1
LLM_MODEL=deepseek-v4-flash

# 本地 ONNX，不打 New API。中文小模型，512 维。
EMBEDDER_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMS=512
