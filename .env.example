# control-plane
CONTROL_PLANE_PORT=8080
CONTROL_PLANE_URL=http://127.0.0.1:8080
DEFAULT_ORG_ID=org_local
DEFAULT_USER_ID=user_local
WORKER_IMAGE=neo-cloud-agent-worker:dev
DEFAULT_MODEL=neo/deepseek
# local | docker | none | firecracker | vm
# vm = 几个可挂载槽位。有 /dev/kvm 走 Firecracker，否则 loop 挂 ext4 再跑本地 worker。
# 4C/4G 建议 VM_SLOT_COUNT=2、WORKER_MEMORY_MIB=512、WORKER_DISK_GIB=4。
WORKER_RUNTIME=local
# VM_SLOT_COUNT=2
# VM_SLOTS_DIR=.neo/vms
# WORKER_CPUS=1
# WORKER_MEMORY_MIB=512
# WORKER_DISK_GIB=4
# loop / local worker 会套上堆上限；有 cgroup Delegate 时再套 RSS。
# OBJECT_STORE=fs
# OBJECT_STORE=s3
SPAWN_LOCAL_WORKER=1
RUNS_DIR=.neo/runs
HOST_RUNS_DIR=
WORKER_CONTROL_PLANE_URL=
WORKER_LLM_GATEWAY_URL=
WORKER_WORKSPACE_MOUNT=/workspace
DOCKER_NETWORK=

# Desk / Web clients.
# pnpm dev:web       -> Web UI :5173，本地 :8080
# pnpm dev:mobile    -> 手机客户端 :5175，本地 :8080
# pnpm dev:desk      -> 预发完整服务：本机 :8080/:8081 + Desk :5174
# pnpm dev:desk:prod -> 生产完整服务：Desk :5174 → 线上控制面
# NEO_DESK_UI_PORT=5174
# NEO_DESK_URL=http://127.0.0.1:5174
# NEO_CONTROL_PLANE_URL=http://127.0.0.1:8080
# NEO_CONTROL_PLANE_URL=http://62.234.211.200
# NEO_DESK_FOLDER=

# llm-gateway (the only process that may hold provider keys)
LLM_GATEWAY_PORT=8081
LLM_GATEWAY_URL=http://127.0.0.1:8081
LLM_GATEWAY_JWT_SECRET=dev-only-change-me
# mock | openai | deepseek
# If unset: deepseek when DEEPSEEK_API_KEY is set, openai when OPENAI_API_KEY is set, otherwise mock.
# The chat page can also save a key to .neo/llm-upstream.env (gitignored); that file overrides LLM_UPSTREAM=mock.
LLM_UPSTREAM=deepseek
LLM_UPSTREAM_BASE_URL=https://api.deepseek.com/v1
LLM_UPSTREAM_MODEL=deepseek-v4-flash
# Idle loop/Firecracker slots: persist workspace, then unmount. 0 disables.
# WORKER_IDLE_RELEASE_MS=900000
LLM_UPSTREAM_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
LLM_API_KEY=
ANTHROPIC_API_KEY=

# worker (injected per Run; not a cluster Deployment)
RUN_ID=
LLM_GATEWAY_JWT=
WORKSPACE_DIR=/workspace
SESSION_DIR=/var/neo/sessions
NEO_MODEL=neo/deepseek

# Environment Builds / warm pool
# WARM_POOL_SIZE=1
# BUILD_CAPTURE=1

# 用户账号（默认必须手输 admin / 123456；ACCOUNTS_REQUIRED=0 才允许匿名）
# ACCOUNTS_REQUIRED=1
# DEFAULT_ADMIN=1
# DEFAULT_ADMIN_PASSWORD=123456
# BOOTSTRAP_EMAIL=you@example.com
# BOOTSTRAP_PASSWORD=at-least-8-chars
# 额外平台管理员（逗号分隔登录名/邮箱）。`admin` 和服务令牌始终是管理员。
# ADMIN_EMAILS=ops@example.com
# 独立管理台（不要和对话页 :5173 / 控制面 :8080 混用）
# ADMIN_API_PORT=8090
# ADMIN_WEB_PORT=5176
# New API 只做模型控制台入口，不在 Neo 里改渠道。
# NEW_API_URL=http://127.0.0.1:3000
# NEW_API_CONSOLE_URL=http://127.0.0.1:3000

# 元数据 / 热事件（不设则用 .control JSON + 进程内事件总线）
# DATABASE_URL=mysql://app:app@127.0.0.1:3306/app
# DATABASE_URL=postgres://neo:neo@127.0.0.1:5432/neo
# REDIS_URL=redis://:pass@127.0.0.1:6379

# Firecracker（需要 /dev/kvm、内核；没配 ROOTFS 时尝试打 overlay ext4）
# WORKER_RUNTIME=firecracker
# FIRECRACKER_BIN=infra/firecracker/.assets/firecracker
# FIRECRACKER_KERNEL=infra/firecracker/.assets/vmlinux
# FIRECRACKER_ROOTFS=infra/firecracker/.assets/rootfs.ext4
# FIRECRACKER_NET=tap
# WORKER_DISK_GIB=8

# GitHub webhook（PR 评论 / Actions 唤醒 run）。不设则控制面首次启动会写
# $RUNS_DIR/.control/github-webhook.secret，把同一值配到仓库 webhook 的 secret。
# 现网路径：http://<app-host>/webhooks/github
# GITHUB_WEBHOOK_SECRET=

# 对外网址（定时任务通知、Telegram setWebhook、微信公众号 URL）
# PUBLIC_APP_URL=http://62.234.211.200
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=
# WECOM_WEBHOOK_URL=
# NOTIFY_HTTP_URL=
# WECHAT_TOKEN=
# NOTIFY_DEFAULT_REPO=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# NOTIFY_EMAIL_TO=

# 组织配额。0 或不设 = 不限。也可在对话页设置里写到 .neo/quota.env。
# QUOTA_MAX_TOKENS_MONTH=0
# QUOTA_MAX_CONCURRENT_RUNS=0

# 接口限流。默认生产开启（单测环境自动关，除非 RATE_LIMIT=1）。0 = 关闭某一档。
# RATE_LIMIT=1
# RATE_LIMIT_TRUST_PROXY=1
# RATE_LIMIT_IP=240
# RATE_LIMIT_LOGIN=20
# RATE_LIMIT_LOGIN_ACCOUNT=8
# RATE_LIMIT_API=180
# RATE_LIMIT_WRITE=60
# RATE_LIMIT_CREATE_RUN=12
# RATE_LIMIT_FOLLOW_UP=30
# RATE_LIMIT_EXPENSIVE=10
# RATE_LIMIT_WEBHOOK=120
# RATE_LIMIT_SSE=6
# RATE_LIMIT_LLM_RUN=90
# RATE_LIMIT_LLM_ORG=180
# RATE_LIMIT_LLM_INFLIGHT_RUN=3
# RATE_LIMIT_LLM_INFLIGHT_ORG=12

# GitHub push / 开 PR（控制面持有；也可在对话页设置里存 PAT 到 .neo/scm-push.env）
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY=
# SCM_PUSH_TOKEN=
